# SwiftFleet API Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Required in production, falls back to in-memory in development)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/swiftfleet?retryWrites=true&w=majority

# JWT Authentication Secret (Must be >=16 characters in production)
JWT_SECRET=replace_with_a_secure_random_production_secret_key_2026
JWT_EXPIRES_IN=7d

# AES-256-GCM Encryption Key for Sensitive KYC Compliance Identifiers (Required in production)
# Format: Exactly 32 bytes (64-character hexadecimal string, or 32-character UTF-8 string)
# Safe generation commands (run in terminal to generate a secure random key):
#   OpenSSL:    openssl rand -hex 32
#   Node.js:    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit real keys to source control.
ENCRYPTION_KEY=replace_with_a_64_character_hex_encryption_key_for_production

# Allowed Frontend Client Origin(s) for CORS & Socket.IO (comma-separated for multiple)
CLIENT_ORIGIN=http://localhost:5173,https://swiftfleet-rosy.vercel.app

# Frontend Base URL for Password Reset Links (Defaults to https://swiftfleet-rosy.vercel.app in production)
CLIENT_URL=https://swiftfleet-rosy.vercel.app

# Dispatch & Indian Fare Configuration (INR)
CURRENCY=INR
CURRENCY_SYMBOL=₹
BASE_DELIVERY_FARE=40.00
PER_KM_RATE=12.00
WEIGHT_SURCHARGE_PER_KG=15.00
CATEGORY_SURCHARGE=25.00
PARTNER_PAYOUT_RATIO=0.78
OFFER_TIMEOUT_SECONDS=45

# Regional Center Coordinates (Default: Delhi NCR)
DEFAULT_LAT=28.6139
DEFAULT_LNG=77.2090

# Automated Seeding (Disabled in production)
AUTO_SEED=false
