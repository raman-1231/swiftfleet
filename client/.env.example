# SwiftFleet Client Environment Configuration

# Backend API Endpoint URL (Leave blank for same-origin dev proxy, or provide full URL for decoupled deployment)
# VITE_API_URL=https://swiftfleet-api.onrender.com

# Backend Socket.IO Server URL (Leave blank to use VITE_API_URL or window.location.origin)
# VITE_SOCKET_URL=https://swiftfleet-api.onrender.com

# Map Tile & Geolocation Configuration (Optional - Defaults to clean OpenStreetMap tiles with no API key or watermark)
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_CARTO_API_KEY=your_carto_api_key_here
# VITE_DEFAULT_LAT=28.6139
# VITE_DEFAULT_LNG=77.2090

# Demo Persona Switcher & Quick Fill (Strictly disabled in production builds unless explicitly enabled)
# VITE_ENABLE_DEMO=false
